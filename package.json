{
  "name": "@salesai-prod/n8n-nodes-jobber",
  "version": "0.1.0",
  "description": "n8n community node for Jobber field service management",
  "homepage": "https://github.com/salesai-prod/n8n-nodes-jobber#readme",
  "bugs": {
    "url": "https://github.com/salesai-prod/n8n-nodes-jobber/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salesai-prod/n8n-nodes-jobber.git"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "jobber",
    "field-service"
  ],
  "license": "MIT",
  "author": "Eric Mey",
  "main": "dist/nodes/Jobber/Jobber.node.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19 <=24"
  },
  "scripts": {
    "build": "npm run clean && tsc && npm run copy:icons",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "copy:icons": "node scripts/copy-icons.js",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/credentials",
    "dist/nodes"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/JobberOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Jobber/Jobber.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.3.0",
    "n8n-workflow": "^2.20.3",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": ">=2.17.0"
  }
}
